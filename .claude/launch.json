{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Teleprompter (npx serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-p", "3000", "."],
      "port": 3000
    },
    {
      "name": "Teleprompter (Python http.server)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "3000"],
      "port": 3000
    },
    {
      "name": "Teleprompter (go run)",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "."],
      "port": 3000
    }
  ]
}
